    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1
        - /Planned Path1
        - /Smoothed Path1
        - /Smoothed Path1/Topic1
        - /Goal1
      Splitter Ratio: 0.6235294342041016
    Tree Height: 1191
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
